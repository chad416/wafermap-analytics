# Copy to .env and adjust. Every WAFERMAP_* variable maps to backend/src/wafermap/config.py.

# --- docker compose ---
POSTGRES_USER=wafermap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wafermap
API_PORT=8000
WEB_PORT=8080
# Ingest only the first N lots for a quicker demo (empty = all 10,762 lots, ~245k wafers)
SEED_LIMIT_LOTS=

# --- backend (local, non-docker) ---
# Default: SQLite file at data/wafermap.db
# WAFERMAP_DATABASE_URL=sqlite:///data/wafermap.db
# WAFERMAP_DATABASE_URL=postgresql+psycopg://wafermap:change-me@localhost:5432/wafermap
WAFERMAP_DEFAULT_MODEL=cnn
# WAFERMAP_MODEL_DIR=models
# WAFERMAP_CORS_ORIGINS=["http://localhost:5173"]
